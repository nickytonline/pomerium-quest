#!/usr/bin/env bash
# Pomerium Quest: run the game behind a real Pomerium on a local k3d (k3s-in-Docker) cluster.
#
#   ./quest up        create the cluster (if needed), build, deploy, print the URL
#   ./quest dev       same, but the game runs its Vite dev server and hot-reloads app/src
#   ./quest down      delete the cluster
#   ./quest status    show pods
#   ./quest logs X    follow logs for pomerium | quest | keycloak
#   ./quest admin     open Keycloak's admin console (the Oracle) on http://localhost:8080
#   ./quest reset-oracle  forget every player: re-import the Keycloak realm from scratch
#
# Environment: QUEST_PORT (default 443), QUEST_DOMAIN (default localhost.pomerium.io).
set -euo pipefail

cd "$(dirname "$0")"

CLUSTER=quest
CONTEXT="k3d-${CLUSTER}"
NAMESPACE=quest
POMERIUM_NAMESPACE=pomerium
PORT="${QUEST_PORT:-443}"
DOMAIN="${QUEST_DOMAIN:-localhost.pomerium.io}"
STATE=.quest
CERTS="${STATE}/certs"
export QUEST_PORT="$PORT" QUEST_DOMAIN="$DOMAIN"

say() { printf '\033[1;35m▸\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
kc() { kubectl --context "$CONTEXT" "$@"; }

url() {
  if [ "$PORT" = 443 ]; then echo "https://game.${DOMAIN}"; else echo "https://game.${DOMAIN}:${PORT}"; fi
}

require() {
  local missing=()
  for tool in docker k3d kubectl mkcert node; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo "Missing: ${missing[*]}"
    echo "macOS:          brew install ${missing[*]}"
    echo "Linux, Windows: see \"Play it on a real Pomerium\" in README.md (on Windows, run ./quest in WSL 2)"
    exit 1
  fi
  docker info >/dev/null 2>&1 ||
    fail "Docker isn't running. Start Docker Desktop (or OrbStack, Colima or the Docker service) and try again."
}

cluster_exists() { k3d cluster list "$CLUSTER" >/dev/null 2>&1; }

certs() {
  mkdir -p "$CERTS"
  if [ ! -f "${CERTS}/tls.crt" ]; then
    say "Creating a locally trusted certificate for *.${DOMAIN} (mkcert may ask for your password once)"
    mkcert -install
    mkcert -cert-file "${CERTS}/tls.crt" -key-file "${CERTS}/tls.key" "*.${DOMAIN}" "${DOMAIN}"
  fi
  cp "$(mkcert -CAROOT)/rootCA.pem" "${CERTS}/ca.crt"
}

cluster() {
  if cluster_exists; then
    say "Cluster ${CLUSTER} already exists"
    return
  fi
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    fail "Port ${PORT} is in use. Free it, or run with another port: QUEST_PORT=8443 ./quest up"
  fi
  say "Creating k3d cluster ${CLUSTER} on port ${PORT}"
  k3d cluster create "$CLUSTER" \
    --port "${PORT}:${PORT}@loadbalancer" \
    --k3s-arg "--disable=traefik@server:0" \
    --volume "$(pwd):/quest-src@server:0" \
    --wait
}

images() {
  say "Building images"
  docker build --target app -t pomerium-quest/app:dev .
  say "Loading images into the cluster"
  k3d image import -c "$CLUSTER" pomerium-quest/app:dev
}

dev_image() {
  say "Building the dev image"
  docker build --target app-dev -t pomerium-quest/app-dev:dev .
  say "Loading images into the cluster"
  k3d image import -c "$CLUSTER" pomerium-quest/app-dev:dev
}

# Clusters made before `./quest dev` existed don't have the repo mounted into the node.
require_source_mount() {
  docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "k3d-${CLUSTER}-server-0" | grep -q /quest-src ||
    fail "This cluster was created without the source mount dev mode needs. Recreate it: ./quest down && ./quest dev"
}

deploy() {
  say "Rendering the Pomerium Ingress Controller and an Ingress per zone from app/src/game/zones.ts"
  QUEST_DEV="${QUEST_DEV:-0}" node scripts/render.ts
  # Clusters from before the Ingress Controller ran Pomerium from a config file in the game's namespace,
  # and clusters from before Keycloak still run the old Node Oracle.
  kc -n "$NAMESPACE" delete deployment/pomerium service/pomerium secret/pomerium-config \
    deployment/oracle service/oracle pvc/oracle-data networkpolicy/oracle-from-pomerium-and-quest \
    --ignore-not-found >/dev/null 2>&1 || true
  kc apply -f deploy/.generated/pomerium.yaml >/dev/null
  kc wait --for condition=established crd/pomerium.ingress.pomerium.io --timeout=60s >/dev/null
  kc -n "$POMERIUM_NAMESPACE" create secret tls quest-tls --cert="${CERTS}/tls.crt" --key="${CERTS}/tls.key" \
    --dry-run=client -o yaml | kc apply -f -
  kc -n "$POMERIUM_NAMESPACE" create secret generic quest-ca --from-file=ca.crt="${CERTS}/ca.crt" \
    --dry-run=client -o yaml | kc apply -f -
  kc apply -f deploy/.generated/manifests.yaml
  kc -n "$NAMESPACE" create secret generic quest-tls \
    --from-file=tls.crt="${CERTS}/tls.crt" \
    --from-file=tls.key="${CERTS}/tls.key" \
    --from-file=ca.crt="${CERTS}/ca.crt" \
    --dry-run=client -o yaml | kc apply -f -
  # Pick up the DNS rewrite, new images and new config.
  kc -n kube-system rollout restart deployment/coredns
  kc -n "$NAMESPACE" rollout restart deployment
  say "Waiting for Pomerium, the Oracle (Keycloak) and the game"
  kc -n kube-system rollout status deployment/coredns --timeout=120s
  for d in keycloak quest; do kc -n "$NAMESPACE" rollout status "deployment/${d}" --timeout=300s; done
  kc -n "$POMERIUM_NAMESPACE" rollout status deployment/pomerium --timeout=300s
  townsfolk
  deed
  # Pomerium needs a few seconds after the rollout to load certificates and policies.
  for _ in $(seq 1 60); do
    if curl -fsS -o /dev/null "$(url)/" 2>/dev/null; then return; fi
    sleep 1
  done
  fail "Pomerium didn't answer at $(url). Check: ./quest logs pomerium"
}

# The townsfolk who visit players' houses get real Oracle accounts, imported (and reset) at every deploy.
# Keycloak only imports its realm on first start, so the groups they belong to are created first if an
# older realm doesn't have them yet (an existing group is left alone, with its members).
townsfolk() {
  local password groups
  password="$(node -p "require('./${STATE}/secrets.json').keycloakAdminPassword")"
  groups="$(node -p "[...new Set(require('./deploy/.generated/townsfolk.json').users.flatMap((u) => u.groups))].map((g) => g.slice(1)).join(' ')")"
  kc -n "$NAMESPACE" exec -i deploy/keycloak -- sh -c '
    cat >/tmp/townsfolk.json
    kcadm=/opt/keycloak/bin/kcadm.sh
    $kcadm config credentials --config /tmp/kcadm.config --server http://localhost:8080 \
      --realm master --user admin --password "$1" >/dev/null 2>&1 || exit 1
    for group in $2; do
      $kcadm create groups --config /tmp/kcadm.config -r kingdom -s "name=$group" >/dev/null 2>&1 || true
    done
    $kcadm create partialImport --config /tmp/kcadm.config -r kingdom -f /tmp/townsfolk.json >/dev/null
    status=$?
    rm -f /tmp/townsfolk.json
    exit $status
  ' sh "$password" "$groups" <deploy/.generated/townsfolk.json || fail "Couldn't add the townsfolk to the Oracle"
}

# An older realm has no deed attribute or claim mapper, and Keycloak drops attributes its user profile
# doesn't declare. Declare the attribute (the profile is the same one the realm imports) and add the
# mapper to Pomerium's client unless it's already there.
deed() {
  local password
  password="$(node -p "require('./${STATE}/secrets.json').keycloakAdminPassword")"
  tar -c -C deploy/.generated deed-profile.json deed-mapper.json | kc -n "$NAMESPACE" exec -i deploy/keycloak -- sh -c '
    tar -x -C /tmp
    kcadm=/opt/keycloak/bin/kcadm.sh
    $kcadm config credentials --config /tmp/kcadm.config --server http://localhost:8080 \
      --realm master --user admin --password "$1" >/dev/null 2>&1 || exit 1
    $kcadm update users/profile --config /tmp/kcadm.config -r kingdom -f /tmp/deed-profile.json >/dev/null || exit 1
    client="$($kcadm get clients --config /tmp/kcadm.config -r kingdom -q clientId=pomerium --fields id --format csv --noquotes)"
    $kcadm get "clients/$client/protocol-mappers/models" --config /tmp/kcadm.config -r kingdom --fields name --format csv --noquotes \
      | grep -qx deed \
      || $kcadm create "clients/$client/protocol-mappers/models" --config /tmp/kcadm.config -r kingdom -f /tmp/deed-mapper.json >/dev/null
    status=$?
    rm -f /tmp/deed-profile.json /tmp/deed-mapper.json
    exit $status
  ' sh "$password" || fail "Couldn't add the deed claim to the Oracle"
}

case "${1:-up}" in
  up)
    require
    certs
    cluster
    images
    deploy
    say "Ready: $(url)"
    ;;
  dev)
    require
    certs
    cluster
    require_source_mount
    dev_image
    QUEST_DEV=1 deploy
    say "Ready: $(url) (hot-reloading app/src; ./quest deploy goes back to the production build)"
    ;;
  deploy)
    require
    certs
    images
    deploy
    say "Ready: $(url)"
    ;;
  down)
    k3d cluster delete "$CLUSTER"
    ;;
  status)
    kc -n "$POMERIUM_NAMESPACE" get pods,svc
    kc -n "$NAMESPACE" get pods,svc,ingress
    ;;
  test)
    bash scripts/e2e.sh
    ;;
  logs)
    if [ "${2:-pomerium}" = pomerium ]; then kc -n "$POMERIUM_NAMESPACE" logs -f deployment/pomerium
    else kc -n "$NAMESPACE" logs -f "deployment/$2"; fi
    ;;
  admin)
    password="$(node -p "require('./${STATE}/secrets.json').keycloakAdminPassword")"
    # The admin console signs in through the master realm, which Pomerium doesn't route. Point
    # that realm at the forwarded port so admin sign-in never touches the public host.
    kc -n "$NAMESPACE" exec deploy/keycloak -- sh -c '
      kcadm=/opt/keycloak/bin/kcadm.sh
      $kcadm config credentials --config /tmp/kcadm.config --server http://localhost:8080 \
        --realm master --user admin --password "$1" >/dev/null 2>&1 &&
      $kcadm update realms/master --config /tmp/kcadm.config -s attributes.frontendUrl=http://localhost:8080
    ' sh "$password"
    say "Keycloak admin console: http://localhost:8080/admin/master/console/#/kingdom (user admin, password ${password})"
    say "The game's realm is \"kingdom\". Ctrl-C to stop."
    kc -n "$NAMESPACE" port-forward service/keycloak 8080:8080
    ;;
  reset-oracle)
    say "Forgetting every player and re-importing the realm"
    kc -n "$NAMESPACE" scale deployment/keycloak --replicas=0
    kc -n "$NAMESPACE" wait --for=delete pod -l app=keycloak --timeout=120s 2>/dev/null || true
    kc -n "$NAMESPACE" delete pvc/keycloak-data
    # Re-apply the last render (dev or not) to recreate the volume and start Keycloak again.
    kc apply -f deploy/.generated/manifests.yaml >/dev/null
    kc -n "$NAMESPACE" rollout status deployment/keycloak --timeout=300s
    townsfolk
    say "Ready: $(url)"
    ;;
  *)
    echo "usage: ./quest [up|dev|deploy|down|status|test|admin|reset-oracle|logs pomerium|quest|keycloak]"
    exit 1
    ;;
esac
